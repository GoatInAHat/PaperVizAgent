# Generated by toolfactory from dev.toolfactory/tool.json `config`. Copy to `.env` and fill in.

# Optional path to shared PaperVizAgent JSON/YAML model and pipeline configuration. (optional)
PAPERVIZAGENT_CODEX_CONFIG=

# Optional externally supplied Codex OAuth access token. Existing Codex sign-in is used when omitted. (optional, secret)
CODEX_OAUTH_TOKEN=

# Optional account ID for an external token whose JWT does not contain it. (optional)
CODEX_ACCOUNT_ID=

# Optional Gemini API key. (optional, secret)
GOOGLE_API_KEY=

# Optional OpenAI API key, separate from Codex OAuth. (optional, secret)
OPENAI_API_KEY=

# Optional Anthropic API key. (optional, secret)
ANTHROPIC_API_KEY=

# Release credentials (repository secrets; `toolfactory bootstrap-repo` pushes them from .env,
# `toolfactory secrets status` explains each). Leave one empty to skip that registry.

# npm: https://www.npmjs.com/settings/~/tokens
NPM_TOKEN=

# clawhub-package: https://clawhub.ai
CLAWHUB_TOKEN=

# clawhub-skill: https://clawhub.ai
CLAWHUB_TOKEN=

# chrome: https://chrome.google.com/webstore/devconsole
CHROME_EXTENSION_ID=
CHROME_PUBLISHER_ID=
CHROME_SERVICE_ACCOUNT_CLIENT_EMAIL=
CHROME_SERVICE_ACCOUNT_PRIVATE_KEY=

# firefox: https://addons.mozilla.org/developers/addon/api/key/
FIREFOX_EXTENSION_ID=
FIREFOX_JWT_ISSUER=
FIREFOX_JWT_SECRET=

# edge: https://partner.microsoft.com/dashboard/microsoftedge/publishapi
EDGE_PRODUCT_ID=
EDGE_CLIENT_ID=
EDGE_API_KEY=
