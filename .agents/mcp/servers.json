{
  "toolfactory": {
    "command": "npx",
    "args": [
      "toolfactory",
      "mcp"
    ]
  },
  "shadcn": {
    "command": "npx",
    "args": [
      "shadcn@latest",
      "mcp"
    ]
  },
  "playwright": {
    "command": "npx",
    "args": [
      "@playwright/mcp@latest"
    ]
  },
  "papervizagent": {
    "command": "uv",
    "args": [
      "run",
      "--quiet",
      "python",
      "-m",
      "papervizagent.toolfactory.mcp"
    ]
  }
}
